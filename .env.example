# ============================================================
#  Teamverwaltung – Umgebungsvariablen (Vorlage)
#  Kopieren zu ".env" und mit echten Werten befüllen.
#  Die ".env" selbst NIEMALS committen!
# ============================================================

# ── Verschlüsselungs-Key (MUSS als erstes gesetzt werden) ──
# Zufälligen Wert erzeugen, z. B.: php -r "echo bin2hex(random_bytes(32));"
# Schützt Werte mit "ENC:"-Präfix (siehe encrypt_env.php). Alternativ kann der
# Key auch in einer Datei außerhalb des Document Roots liegen, siehe README.
APP_SECRET_KEY=

# ── Datenbank (MySQL / MariaDB über phpMyAdmin verwaltet) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teamverwaltung
DB_USER=
# Klartext ODER mit "php encrypt_env.php ..." verschlüsselt als ENC:...
DB_PASS=
DB_CHARSET=utf8mb4

# ── Site ──
SITE_NAME=Teamverwaltung
# Basis-URL der App ohne abschließenden Slash, z.B. https://team.deine-domain.tld
APP_URL=

# ── Discord OAuth2 (Discord Developer Portal → OAuth2 → General) ──
DISCORD_CLIENT_ID=
# Klartext ODER mit "php encrypt_env.php ..." verschlüsselt als ENC:...
DISCORD_CLIENT_SECRET=
# Optional: nur setzen, wenn die Redirect-URI von APP_URL + /discord_callback.php abweichen soll
DISCORD_REDIRECT_URI=
# General Information → Public Key. Aktiviert Zu-/Absage-Buttons unter Besprechungs-
# Ankündigungen ohne Portal-Login (Interactions Endpoint URL: {APP_URL}/discord_interactions.php)
DISCORD_PUBLIC_KEY=

# ── Discord Bot (Rollen-Sync, Mitglieder-Sync, Events) ──
# Bot-Tab in der Discord-App, "Reset Token" — braucht die "Server Members Intent"
# Klartext ODER mit "php encrypt_env.php ..." verschlüsselt als ENC:...
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ── Besprechungs-Ankündigungen ──
# Für Teilnehmen/Vielleicht/Absagen-Buttons OHNE Portal-Login (siehe DISCORD_PUBLIC_KEY
# oben) zwingend nötig: DISCORD_ANNOUNCE_CHANNEL_ID + DISCORD_BOT_TOKEN (Bot braucht
# "Send Messages" im Kanal) — nur eine vom Bot gesendete Nachricht liefert Button-Klicks
# zuverlässig an den Interactions Endpoint aus, ein reiner Webhook kann das nicht.
DISCORD_ANNOUNCE_CHANNEL_ID=
# Alternative/Zusatz ohne interaktive Buttons (nur Text + "Zum Meeting"-Link):
# Webhook-URL eines Kanals (Kanal-Einstellungen → Integrationen → Webhooks). Ist zusätzlich
# ein Bot-Kanal (oben) konfiguriert, hat der bei Buttons automatisch Vorrang.
# Klartext ODER mit "php encrypt_env.php ..." verschlüsselt als ENC:...
DISCORD_WEBHOOK_URL=

# ── Aktivitäts-Log ──
# Optional: Webhook-URL eines Log-Kanals (z. B. "teambot-log"). Ist sie gesetzt, wird jede
# protokollierte Aktion (siehe audit_log() in src/helpers.php — Mitglieder-/Team-/Rang-/
# Besprechungs-Änderungen, Zu-/Absagen, Bewerbungs-Entscheidungen, Discord-Sync, Deploys, Logins)
# zusätzlich als Embed dorthin gepostet. Ohne diese Variable läuft alles wie bisher, nur ohne
# Discord-Benachrichtigung. Klartext ODER mit "php encrypt_env.php ..." verschlüsselt als ENC:...
DISCORD_LOG_WEBHOOK_URL=

# ── Bewerbungs-Benachrichtigungen ──
# Optional: Webhook-URL eines Kanals, in den neue Bewerbungen (careers_apply.php) gepostet
# werden, mit Ping auf die Discord-Rollen der Ränge "Teamleitung" und "Stv. Teamleitung"
# (Rollen-IDs kommen aus ranks.discord_role_id, unter Ränge einstellbar — nicht hier).
# Klartext ODER mit "php encrypt_env.php ..." verschlüsselt als ENC:...
DISCORD_APPLICATIONS_WEBHOOK_URL=

# ── Development-/Fehler-Log ──
# Optional: Webhook-URL eines Kanals, in den uncaught Exceptions, PHP-Fehler/Warnings und
# Fatal Errors aus der gesamten Anwendung automatisch gepostet werden (siehe bootstrap.php).
# Getrennt vom Aktivitäts-Log oben — hier landen nur unerwartete/technische Fehler, keine
# normalen Nutzeraktionen. Klartext ODER mit "php encrypt_env.php ..." verschlüsselt als ENC:...
DISCORD_DEV_LOG_WEBHOOK_URL=
