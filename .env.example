# ============================================================
#  Teamverwaltung – Umgebungsvariablen (Vorlage)
#  Kopieren zu ".env" und mit echten Werten befüllen.
#  Die ".env" selbst NIEMALS committen!
# ============================================================

# ── Verschlüsselungs-Key (MUSS als erstes gesetzt werden) ──
# Zufälligen Wert erzeugen, z. B.: php -r "echo bin2hex(random_bytes(32));"
# Schützt Werte mit "ENC:"-Präfix (siehe encrypt_env.php). Alternativ kann der
# Key auch in einer Datei außerhalb des Document Roots liegen, siehe README.
APP_SECRET_KEY=

# ── Datenbank (MySQL / MariaDB über phpMyAdmin verwaltet) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teamverwaltung
DB_USER=
# Klartext ODER mit "php encrypt_env.php ..." verschlüsselt als ENC:...
DB_PASS=
DB_CHARSET=utf8mb4

# ── Site ──
SITE_NAME=Teamverwaltung
# Basis-URL der App ohne abschließenden Slash, z.B. https://team.deine-domain.tld
APP_URL=

# ── Discord OAuth2 (Discord Developer Portal → OAuth2 → General) ──
DISCORD_CLIENT_ID=
# Klartext ODER mit "php encrypt_env.php ..." verschlüsselt als ENC:...
DISCORD_CLIENT_SECRET=
# Optional: nur setzen, wenn die Redirect-URI von APP_URL + /discord_callback.php abweichen soll
DISCORD_REDIRECT_URI=
# General Information → Public Key. Aktiviert Zu-/Absage-Buttons unter Besprechungs-
# Ankündigungen ohne Portal-Login (Interactions Endpoint URL: {APP_URL}/discord_interactions.php)
DISCORD_PUBLIC_KEY=

# ── Discord Bot (Rollen-Sync, Mitglieder-Sync, Events) ──
# Bot-Tab in der Discord-App, "Reset Token" — braucht die "Server Members Intent"
# Klartext ODER mit "php encrypt_env.php ..." verschlüsselt als ENC:...
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ── Besprechungs-Ankündigungen ──
# Bevorzugt: Webhook-URL eines Kanals (Kanal-Einstellungen → Integrationen → Webhooks)
# Klartext ODER mit "php encrypt_env.php ..." verschlüsselt als ENC:...
DISCORD_WEBHOOK_URL=
# Alternative, falls kein Webhook: Channel-ID (Bot braucht "Send Messages" im Kanal)
DISCORD_ANNOUNCE_CHANNEL_ID=
