# ============================================================
#  Teamverwaltung RSVP-Bot – Umgebungsvariablen (Vorlage)
#  Kopieren zu ".env" und mit echten Werten befüllen.
#  Die ".env" selbst NIEMALS committen!
#
#  Werte kommen aus der .env der PHP-Anwendung (../.env) — außer wo anders
#  vermerkt, dieselben Werte hier eintragen (Discord-Werte sind ohnehin
#  identisch, DB-Werte ebenso, da beide auf dieselbe Datenbank zugreifen).
# ============================================================

# Discord Bot-Token — GENAU derselbe wie DISCORD_BOT_TOKEN in ../.env (dort ggf.
# ENC:-verschlüsselt, hier immer im Klartext, da dieser Bot kein eigenes
# Verschlüsselungs-Setup hat).
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Dieselbe Datenbank wie die PHP-Anwendung (../.env DB_*).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teamverwaltung
DB_USER=
DB_PASS=

# Optional: Aktivitäts-Log-Webhook (derselbe Kanal wie DISCORD_LOG_WEBHOOK_URL in ../.env,
# hier aber im Klartext einzutragen) — RSVP-per-Discord-Klicks werden dann zusätzlich dort
# protokolliert, genau wie bei RSVP über das Portal.
DISCORD_LOG_WEBHOOK_URL=
